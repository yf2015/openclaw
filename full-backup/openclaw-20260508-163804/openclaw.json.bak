{
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "models": {
        "minimax-portal/MiniMax-M2.7": {
          "alias": "minimax-m2.7"
        },
        "minimax-portal/MiniMax-M2.7-highspeed": {
          "alias": "minimax-m2.7-highspeed"
        }
      },
      "model": {
        "primary": "minimax-portal/MiniMax-M2.7"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "f59981fa5ef77e1d4122e7090e145c4cf3e5320b6b5a0b8d"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "nodes": {
      "denyCommands": [
