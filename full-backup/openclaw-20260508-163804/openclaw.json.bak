  },
  "tools": {
    "profile": "coding"
  },
  "plugins": {
    "entries": {
      "minimax": {
        "enabled": true
      },
      "dingtalk-connector": {
        "enabled": true
      }
    }
  },
  "models": {
    "providers": {
